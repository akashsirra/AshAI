# Model providers (AshAI automatically fails over in this order)
ASHAI_API_KEY=
ASHAI_BASE_URL=https://api.groq.com/openai/v1
ASHAI_MODEL=openai/gpt-oss-20b
ASHAI_GEMINI_API_KEY=
ASHAI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
ASHAI_GEMINI_MODEL=gemini-3.8-flash

# Runtime
ASHAI_WORKSPACE=.
ASHAI_DATA_DIR=.ashai
ASHAI_ARTIFACT_DIR=.ashai/artifacts
ASHAI_ALLOW_MUTATIONS=false
ASHAI_AGENT_LOOP=true
ASHAI_MAX_AGENT_STEPS=24
ASHAI_MAX_CONTROLLER_CALLS=4
ASHAI_GROQ_RETRIES=2
PORT=8787
